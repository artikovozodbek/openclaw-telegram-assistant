# Copy to .env and fill in locally. NEVER commit .env.

# ---- Runtime ----
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_REALTIME_HOST_PORT=8787
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Asia/Tashkent
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENCLAW_GATEWAY_TOKEN=

# ---- LLM providers (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_API_BASE=
CELION_BASE_URL=
CELION_API_KEY=
# Optional second account, used when the first hits its usage limit
CELION_API_KEY_BACKUP=

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to talk to the bot
TELEGRAM_ALLOWED_USER_IDS=

# ---- Telegram MTProto user session (see scripts/mtproto-setup.sh) ----
# TG_USER_SESSION grants full access to your account: treat it like a password.
TG_API_ID=
TG_API_HASH=
TG_USER_SESSION=

# ---- Optional ----
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# optional second account for fallback (fast-lane plugin)
CELION_API_KEY_SECONDARY=
